{% comment %}
  =============================================
  PLUG & PLAY — SHOPIFY THEME SNIPPETS
  =============================================
  Instructions:
  1. Go to Shopify Admin → Online Store → Themes → Edit code
  2. Create a new snippet: Snippets → Add a new snippet → "pnp-tracker-btn"
  3. Paste the button HTML below
  4. Include it in your order confirmation template
  =============================================
{% endcomment %}

{% comment %} ===== TRACK ORDER BUTTON ===== {% endcomment %}
{% comment %} Include in templates/customers/order.liquid {% endcomment %}

<div style="margin: 24px 0; text-align: center;">
  <a
    href="{{ 'REPLACE_WITH_YOUR_TRACKER_URL' | append: '/?order=' | append: order.name | append: '&email=' | append: customer.email | url_encode }}"
    style="
      display: inline-block;
      padding: 14px 32px;
      background: linear-gradient(135deg, #6366f1, #06b6d4);
      color: white;
      font-weight: 700;
      font-size: 16px;
      border-radius: 10px;
      text-decoration: none;
      box-shadow: 0 4px 20px rgba(99,102,241,0.35);
    "
    target="_blank"
  >
    🚚 Track My Order
  </a>
  <p style="margin-top: 10px; font-size: 14px; color: #64748b;">
    Get real-time production updates and delivery estimates
  </p>
</div>

